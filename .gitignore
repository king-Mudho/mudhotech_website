# ── Frontend (Next.js) ───────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# ── Backend (Django) ─────────────────────────────────
backend/.venv/
backend/db.sqlite3
backend/staticfiles/
__pycache__/
*.pyc

# ── Environment files — never commit secrets ─────────
.env
.env*.local
frontend/.env
frontend/.env*.local
backend/.env
backend/.env*.local

# ── Testing ──────────────────────────────────────────
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ── Logs ─────────────────────────────────────────────
logs
*.log
npm-debug.log*

# ── Editor / OS ──────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/

# Stray copies of deploy scripts downloaded for inspection.
/provision.sh
/deploy.sh
/enable-tls.sh
