# Production environment — frontend (Next.js)
#
# Copy to `.env.production` on the server. Never commit the real file.
#
# NEXT_PUBLIC_* values are compiled into the JavaScript sent to every
# visitor's browser. Never put a secret in one.

# Must match the canonical domain in src/data/company.ts EXACTLY, including
# scheme and the presence/absence of "www". A mismatch here silently breaks
# canonical URLs, the sitemap, Open Graph images, and every JSON-LD @id.
NEXT_PUBLIC_SITE_URL=https://mudhotech.com

# Public base for the Django API. Only used for display/diagnostics — the
# browser never calls Django directly; it goes through the Route Handlers.
NEXT_PUBLIC_API_URL=https://mudhotech.com

# GA4. Leave blank to ship no analytics at all. The tag is only emitted when
# this is set AND the visitor accepted cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only. How the Next.js Route Handlers reach Django, server-to-server.
# Keep this on loopback so Django is never reachable from the public internet
# — the three-layer auth model assumes Route Handlers are the only front door.
INTERNAL_API_URL=http://127.0.0.1:8200
