# Client-exposed (safe to ship to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only (Next.js Route Handlers → Django API; never exposed to the browser)
# Set once the admin login proxy is built in Stage 5 — see docs/ARCHITECTURE-DEVIATION.md
INTERNAL_API_URL=http://localhost:8000
