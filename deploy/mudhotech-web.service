# /etc/systemd/system/mudhotech-web.service
# Next.js production server. Bound to loopback — nginx is the only thing
# that talks to it.

[Unit]
Description=MudhoTech website (Next.js)
After=network.target mudhotech-api.service
Wants=mudhotech-api.service

[Service]
Type=simple
User=mudhotech
Group=mudhotech
WorkingDirectory=/srv/mudhotech/frontend
Environment=NODE_ENV=production
Environment=PORT=3200
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/srv/mudhotech/frontend/.env.production
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5

# Hardening. This service needs to read its own directory and talk to
# loopback; nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mudhotech/frontend/.next
ProtectKernelTunables=true
ProtectControlGroups=true
# AF_NETLINK is not optional here. Next.js calls os.networkInterfaces()
# once it has bound, to print its "Network:" line. On glibc that goes
# through getifaddrs(), which opens an AF_NETLINK socket — without it the
# call fails EAFNOSUPPORT (errno 97) and Next exits 1 during startup, with
# a stack trace pointing at uv_interface_addresses and nothing about
# systemd. The process never gets far enough to serve a request.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mudhotech-web

[Install]
WantedBy=multi-user.target
