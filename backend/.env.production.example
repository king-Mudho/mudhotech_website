# Production environment — backend (Django)
#
# Copy to `.env` on the server. Never commit the real file.
# Every value below differs from the development default for a reason.

# Generate a fresh one and paste it here. Do not reuse the dev key, and do
# not let this value appear in git, a screenshot, or a chat window:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Must be false. With DEBUG on, Django serves a full traceback — including
# settings and environment — to anyone who triggers a 500.
DJANGO_DEBUG=false

# Every hostname the app will be served as. A request with a Host header not
# on this list is rejected, which is what blocks Host-header poisoning.
DJANGO_ALLOWED_HOSTS=mudhotech.com,www.mudhotech.com,127.0.0.1,localhost

# The deployed frontend origin(s) only — never "*".
CORS_ALLOWED_ORIGINS=https://mudhotech.com,https://www.mudhotech.com

# ── Email ────────────────────────────────────────────────────────────────
# Without one of these, lead notifications go nowhere: the submission still
# saves and still appears in the dashboard, but nobody is told it arrived.
# With DEBUG=false and no credentials, that is logged as an ERROR rather
# than silently skipped — check the log if notifications stop.
#
# Option A — Resend (HTTP API, best deliverability). Verify mudhotech.com in
# Resend first, then send from a real address on the domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MudhoTech Solutions <noreply@mudhotech.com>
#
# Option B — SMTP via the hosting mailbox.
# EMAIL_HOST=mail.mudhotech.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@mudhotech.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=MudhoTech Solutions <noreply@mudhotech.com>
#
# NOTE: mudhotech.com's MX currently points at Namecheap email forwarding
# (eforward1-5.registrar-servers.com). Forwarding receives mail; it does not
# send it. You need either Resend or a real mailbox before Option B works.

# ── Rate limits ──────────────────────────────────────────────────────────
# Leave these unset in production. The defaults in settings.py ARE the
# production values; the env vars exist only so the e2e suite can raise them
# locally. Setting them here would weaken the public form throttle.
