DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# ── Email ────────────────────────────────────────────────
# The provider is auto-detected from whichever credentials you fill in.
# Pick ONE of the two options below.
#
# Option A — Resend (HTTP API, best deliverability):
RESEND_API_KEY=
RESEND_FROM_EMAIL=MudhoTech Forms <onboarding@resend.dev>
#
# Option B — plain SMTP, e.g. Gmail or a domain mailbox.
# For Gmail you must use an App Password, not the account password
# (Google account → Security → 2-Step Verification → App passwords).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@yourdomain.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=MudhoTech Solutions <you@yourdomain.com>
#
# With neither set, DEBUG=true prints emails to the terminal so you can see
# them working; DEBUG=false logs an ERROR — sending is never silently skipped.
# EMAIL_PROVIDER=resend|smtp|console|none   # only to override auto-detection

# Rate limits. The values below are the production defaults — leave them
# unset in production. Raise them locally only when running the e2e suite,
# which submits real forms and would otherwise exhaust the hourly limit.
# THROTTLE_ANON=20/hour
# THROTTLE_USER=1000/day
# THROTTLE_SUBMISSION=10/hour
